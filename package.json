{
  "name": "opensweep",
  "productName": "OpenSweep",
  "version": "0.3.2",
  "description": "Free, open-source PC care toolkit for Windows 10/11: cleanup, boost, startup, privacy, tweaks, repair and more.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "OpenSweep contributors",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "check": "node test/check.js",
    "dist:win": "electron-builder --win --x64",
    "dist:win-arm64": "electron-builder --win --arm64",
    "test:windows": "node test/windows-smoke.js"
  },
  "build": {
    "appId": "org.opensweep.app",
    "productName": "OpenSweep",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ray0189",
        "repo": "OpenSweep",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ray0189/OpenSweep.git"
  }
}
