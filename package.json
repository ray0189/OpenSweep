{
  "name": "opensweep",
  "productName": "OpenSweep",
  "version": "0.4.0-alpha.2",
  "description": "Free, open-source PC care toolkit for Windows 10/11: cleanup, boost, startup, privacy, tweaks, repair and more.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "OpenSweep contributors",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "check": "node test/check.js",
    "core:build": "cmake -S core -B core/build -A x64 && cmake --build core/build --config Release",
    "core:test": "ctest --test-dir core/build -C Release --output-on-failure",
    "prepare-core": "node scripts/prepare-core.js",
    "dist:win": "node scripts/prepare-core.js && electron-builder --win --x64",
    "dist:win-arm64": "node scripts/prepare-core.js && electron-builder --win --arm64",
    "test:windows": "node test/windows-smoke.js",
    "test:core": "node test/core-ipc.js",
    "test:validate": "node test/core-validate.js",
    "test:bench": "node test/bench-analyze.js",
    "test:unit": "node test/core-client.js && node test/core-validate.js && node test/bench-analyze.js",
    "bench:analyze": "node bench/analyze.js"
  },
  "build": {
    "appId": "org.opensweep.app",
    "productName": "OpenSweep",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/core",
        "to": "core"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ray0189",
        "repo": "OpenSweep",
        "releaseType": "prerelease",
        "channel": "latest"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ray0189/OpenSweep.git"
  }
}
